<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cb.mapper.DeptMapper">

    <select id="getAllDept" resultType="com.cb.entity.dataBaseEntity_jpa.DeptEntity">
        SELECT ID, DEPT_NAME, DEPT_PARENT_ID, REPORT_FLAG,STATUS FROM sys_dept WHERE status!='2'
    </select>
</mapper>